#!/usr/bin/env bash
# Fake psql for evals: returns the case's canned audit rows for audit.sql and simple answers for
# verification SELECTs. Logs every call; flags NOT_READONLY and DDL so graders can fail the run.
d="$(git rev-parse --git-dir 2>/dev/null)/eval-fake"
echo "psql $* | PGOPTIONS=$PGOPTIONS" >> "$d/calls.log"
a=" $* "
shopt -s nocasematch
[[ "$a" =~ \ (--version|-V)\  ]] && { echo "psql (PostgreSQL) 18.0"; exit 0; }
[[ "$PGOPTIONS" == *default_transaction_read_only=on* ]] || echo "NOT_READONLY $*" >> "$d/calls.log"
if [[ "$a" =~ (^|[^a-z_])(insert|update|delete|alter|create|drop|truncate|grant|vacuum|reindex)[[:space:]] ]] && [[ "$a" != *audit.sql* ]]; then
  echo "DDL $*" >> "$d/calls.log"
  echo "ERROR:  cannot execute this in a read-only transaction" >&2; exit 1
fi
if [[ "$a" =~ -f\ +[^\ ]*\.sql ]] && [[ "$a" != *audit.sql* ]]; then
  echo "DDL (script) $*" >> "$d/calls.log"
  echo "ERROR:  cannot execute this in a read-only transaction" >&2; exit 1
fi
case "$a" in
  *audit.sql*) cat "$d/audit.txt" ;;
  *"not exists"*) echo 1 ;;                        # orphan count
  *"is null"*) echo 0 ;;                           # null count before NOT NULL
  *pg_total_relation_size*|*pg_size_pretty*) echo 16384 ;;
  *count\(*) echo 0 ;;
  *version*) echo "PostgreSQL 18.0 on x86_64-pc-linux-gnu" ;;
  *) echo "fake psql: no canned answer, returning no rows" >&2 ;;
esac
exit 0
