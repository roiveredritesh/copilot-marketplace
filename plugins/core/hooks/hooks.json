{
  "description": "Enforced guards: block database writes and ask before git push or GitHub writes (Bash and PowerShell); check each skill's Steps line against the transcript.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/steps-check.sh\"", "timeout": 15 }
        ]
      }
    ]
  }
}
